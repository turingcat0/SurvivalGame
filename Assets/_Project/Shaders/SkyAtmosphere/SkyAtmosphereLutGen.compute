#include "SkyAtmosphereCommon.hlsl"
#pragma require wavebasic
#pragma use_dxc

#pragma kernel kComputeTransmittanceLut
#pragma kernel kComputeMultiScatteringLut
#pragma kernel kComputeSkyViewLut
#pragma kernel kComputeAerialPerspectiveLut


#define TRANSMITTANCE_STEPS 40
#define MULTI_SCATTERING_RAYS 64
#define MULTI_SCATTERING_STEPS 20
#define SKY_VIEW_STEPS 30
#define AERIAL_PERSPECTIVE_STEPS 32


StructuredBuffer<SkyAtmosphereParameters> _SkyAtmosphereParametersBuffer;
RWTexture2D<float4> _TransmittanceLutUAV;
RWTexture2D<float4> _MultiScatteringLutUAV;
RWTexture2D<float4> _SkyViewLutUAV;
RWTexture3D<float4> _AerialPerspectiveLutUAV;

Texture2D<float4> _TransmittanceLut;
SamplerState sampler_TransmittanceLut;
Texture2D<float4> _MultiScatteringLut;
SamplerState sampler_MultiScatteringLut;


float3 GetTransmittanceToBoundary(in SkyAtmosphereParameters skyAtmosphereParameters, float mu, float r)
{
    float distance = DistanceToTopAtmosphereBoundary(GetAtmosphereTop(skyAtmosphereParameters), r, mu);
    float dx = distance / TRANSMITTANCE_STEPS;
    float3 mieExtCoeff = skyAtmosphereParameters.mieScatteringPacked.xyz
                   + skyAtmosphereParameters.mieAbsorption.xyz;

    float3 result = 0.0f;
    for (int i = 0; i <= TRANSMITTANCE_STEPS; ++i)
    {
        float d_i = i * dx;
        float r_i = sqrt(d_i * d_i + 2.0 * r * mu * d_i + r * r);
        float h_i = r_i - GetAtmosphereBottom(skyAtmosphereParameters);
        float intensity_rayleigh_i = GetRayleighIntensity(skyAtmosphereParameters,
                                                          h_i);
        float intensity_mie_i = GetMieIntensity(skyAtmosphereParameters,
                                                h_i);
        float intensity_ozone_i = GetOzoneIntensity(skyAtmosphereParameters,
                                                    h_i);
        float weight_i = (i == 0 || i == TRANSMITTANCE_STEPS) ? 0.5f : 1.0f;
        result += skyAtmosphereParameters.rayleighScattering.xyz * intensity_rayleigh_i * weight_i * dx;
        result += mieExtCoeff *
            intensity_mie_i * weight_i * dx;
        result += skyAtmosphereParameters.ozoneAbsorption.xyz * intensity_ozone_i * weight_i * dx;
    }
    return exp(-result);
}


// Assumes the ray does not hit the ground
float3 GetTransmittanceToTopBoundary(in SkyAtmosphereParameters skyAtmosphere,
                                     float r, float mu)
{
    uint w, h;
    _TransmittanceLut.GetDimensions(w, h);
    float2 uv = GetTransmittanceTextureUvFromRMu(GetAtmosphereBottom(skyAtmosphere), GetAtmosphereTop(skyAtmosphere), r,
                                                 mu, w, h);
    return _TransmittanceLut.SampleLevel(sampler_TransmittanceLut, uv, 0).xyz;
}


float3 GetTransmittance(in SkyAtmosphereParameters skyAtmosphere, float r,
                        float mu, float length, bool intersectsGround)
{
    float r_d = sqrt(length * length + 2.0 * r * mu * length + r * r);
    float mu_d = (r * mu + length) / r_d;
    if (intersectsGround)
    {
        return saturate(
            GetTransmittanceToTopBoundary(skyAtmosphere, r_d, -mu_d) / GetTransmittanceToTopBoundary(
                skyAtmosphere, r, -mu));
    }
    else
    {
        return saturate(
            GetTransmittanceToTopBoundary(skyAtmosphere, r, mu) / GetTransmittanceToTopBoundary(
                skyAtmosphere, r_d, mu_d));
    }
}
float3 GetTransmittanceToTopBoundaryFast(
    in SkyAtmosphereParameters skyAtmosphere,
    float r, float mu, uint texW, uint texH)
{
    float2 uv = GetTransmittanceTextureUvFromRMu(
        GetAtmosphereBottom(skyAtmosphere),
        GetAtmosphereTop(skyAtmosphere),
        r, mu, texW, texH);
    return _TransmittanceLut.SampleLevel(sampler_TransmittanceLut, uv, 0).xyz;
}


float GetSunVisibility(in SkyAtmosphereParameters skyAtmosphere, float r,
                             float mu)
{
    // mu is the cosine of the zenith angle to the sun (dot(sunDir, up))
    // We need to compute visibility based on whether the sun is above the horizon

    float sinThetaH = saturate(GetAtmosphereBottom(skyAtmosphere) / r);
    float cosThetaH = -sqrt(max(0.0, 1.0 - sinThetaH * sinThetaH));

    // Smooth transition across the sun's angular diameter at the horizon
    // This accounts for the sun being a disk rather than a point light
    float sunAngularRadius = GetSunAngular(skyAtmosphere);
    float edge0 = cosThetaH - sinThetaH * sunAngularRadius;
    float edge1 = cosThetaH + sinThetaH * sunAngularRadius;

    return smoothstep(edge0, edge1, mu);
}


float3 GetMultiScattering(in SkyAtmosphereParameters skyAtmosphere, float r, float mu)
{
    float u = UnitRangeToUV(mu);
    float v = (r - GetAtmosphereBottom(skyAtmosphere)) / GetAtmosphereHeight(skyAtmosphere);
    return _MultiScatteringLut.SampleLevel(sampler_MultiScatteringLut, float2(u, v), 0).xyz;
}


[numthreads(16, 16, 1)]
void kComputeTransmittanceLut(uint3 id : SV_DispatchThreadID)
{
    SkyAtmosphereParameters skyAtmosphereParameters = GetWorkingSkyAtmosphereParameters(_SkyAtmosphereParametersBuffer[0]);

    uint2 size;
    _TransmittanceLutUAV.GetDimensions(size.x, size.y);
    if (id.x >= size.x || id.y >= size.y)
    {
        return;
    }

    float2 uv = (float2(id.xy) + 0.5f) / size.xy;
    float r, mu;
    GetRMuFromTransmittanceTextureUv(
        GetAtmosphereBottom(skyAtmosphereParameters), GetAtmosphereTop(skyAtmosphereParameters),
        uv, size.x, size.y,
        r, mu);

    float3 transmittance = GetTransmittanceToBoundary(skyAtmosphereParameters, mu, r);
    _TransmittanceLutUAV[id.xy] = float4(transmittance, 1.0f);
}


// Optimized from 0.02278ms to 0.00271ms
[numthreads(32, 1, 1)]
void kComputeMultiScatteringLut(uint3 groupId : SV_GroupID,
                                 uint gi : SV_GroupIndex)
{
    uint2 pixelId = groupId.xy;

    uint2 size;
    _MultiScatteringLutUAV.GetDimensions(size.x, size.y);
    if (pixelId.x >= size.x || pixelId.y >= size.y)
        return;

    SkyAtmosphereParameters params = GetWorkingSkyAtmosphereParameters(
        _SkyAtmosphereParametersBuffer[0]);

    float bottomR = GetAtmosphereBottom(params);
    float topR = GetAtmosphereTop(params);

    uint transmittanceW, transmittanceH;
    _TransmittanceLut.GetDimensions(transmittanceW, transmittanceH);

    float3 rayleighExtCoeff = params.rayleighScattering.xyz;
    float3 mieScatCoeff = params.mieScatteringPacked.xyz;
    float3 mieExtCoeff = mieScatCoeff + params.mieAbsorption.xyz;
    float3 ozoneAbsCoeff = params.ozoneAbsorption.xyz;
    float3 groundAlbedo = GetGroundAlbedo(params);
    float sunAngularRadius = GetSunAngular(params);
    float scaleR = params.densityProfilePacked.x;
    float scaleM = params.densityProfilePacked.y;
    float ozoneCenter = params.densityProfilePacked.z;
    float ozoneHalfWidth = params.densityProfilePacked.w;
    float invOzoneHalfWidth = 1.0 / max(ozoneHalfWidth, 0.0001);
    float bottomR2 = bottomR * bottomR;
    const float phaseL2 = 1.0 / (4.0 * PI_);

    float2 uv = (pixelId + 0.5) / float2(size);
    float r = bottomR + uv.y * (topR - bottomR);
    float cosTheta = GetUnitRange(uv.x);
    float3 sunRay = float3(sqrt(max(0.0, 1.0 - cosTheta * cosTheta)), cosTheta, 0);
    float3 pos = float3(0, r, 0);
    float r2 = r * r;

    uint rayIndex0 = gi;
    uint rayIndex1 = gi + 32;

    float3 ray0 = FibonacciSphereDir(rayIndex0, MULTI_SCATTERING_RAYS);
    float3 ray1 = FibonacciSphereDir(rayIndex1, MULTI_SCATTERING_RAYS);

    float r_mu0 = ray0.y;
    bool intersects0 = RayIntersectsGround(params, r, r_mu0);
    float dist0 = intersects0
        ? DistanceToBottomAtmosphereBoundary(bottomR, r, r_mu0)
        : DistanceToTopAtmosphereBoundary(topR, r, r_mu0);
    float dx0 = dist0 / MULTI_SCATTERING_STEPS;

    float3 opticalDepth0 = 0;
    float3 finalTrans0 = 1;
    float3 rayL2_0 = 0;
    float3 rayMS_0 = 0;

    [loop]
    for (int i = 0; i < MULTI_SCATTERING_STEPS; ++i)
    {
        float d_i = (i + 0.5) * dx0;
        float3 pos_i = pos + d_i * ray0;

        float r_i_sq = dot(pos_i, pos_i);
        float inv_r_i = rsqrt(r_i_sq);
        float r_i = r_i_sq * inv_r_i;
        float h_i = max(0.0, r_i - bottomR);
        float sun_mu_i = dot(sunRay, pos_i) * inv_r_i;

        float rayleighDensity = exp2(-h_i * scaleR * 1.442695);
        float mieDensity = exp2(-h_i * scaleM * 1.442695);
        float ozoneDensity = max(0.0, 1.0 - abs(h_i - ozoneCenter) * invOzoneHalfWidth);

        float3 rayleighScat = rayleighDensity * rayleighExtCoeff;
        float3 mieScat = mieDensity * mieScatCoeff;
        float3 scattering = rayleighScat + mieScat;
        float3 extinction = rayleighScat + mieDensity * mieExtCoeff
                          + ozoneDensity * ozoneAbsCoeff;

        opticalDepth0 += extinction * dx0;
        float3 transmittance = exp2(-opticalDepth0 * 1.442695);
        finalTrans0 = transmittance;

        float3 sunTrans = GetTransmittanceToTopBoundaryFast(
            params, r_i, sun_mu_i, transmittanceW, transmittanceH);

        float sinThetaH = saturate(bottomR * inv_r_i);
        float cosThetaH = -sqrt(max(0.0, 1.0 - sinThetaH * sinThetaH));
        float edge0 = cosThetaH - sinThetaH * sunAngularRadius;
        float edge1 = cosThetaH + sinThetaH * sunAngularRadius;
        float visibility = smoothstep(edge0, edge1, sun_mu_i);

        float3 stepScatter = transmittance * scattering * dx0;
        rayL2_0 += stepScatter * sunTrans * visibility * phaseL2;
        rayMS_0 += stepScatter;
    }

    if (intersects0)
    {
        float3 hitPos = pos + ray0 * dist0;
        float nDl = saturate(dot(sunRay, hitPos) / bottomR);
        float3 groundSunTrans = GetTransmittanceToTopBoundaryFast(
            params, bottomR, nDl, transmittanceW, transmittanceH);
        float vis_g = smoothstep(-sunAngularRadius, sunAngularRadius, nDl);
        rayL2_0 += groundAlbedo * groundSunTrans * vis_g * nDl * finalTrans0 / PI_;
    }

    float r_mu1 = ray1.y;
    bool intersects1 = RayIntersectsGround(params, r, r_mu1);
    float dist1 = intersects1
        ? DistanceToBottomAtmosphereBoundary(bottomR, r, r_mu1)
        : DistanceToTopAtmosphereBoundary(topR, r, r_mu1);
    float dx1 = dist1 / MULTI_SCATTERING_STEPS;

    float3 opticalDepth1 = 0;
    float3 finalTrans1 = 1;
    float3 rayL2_1 = 0;
    float3 rayMS_1 = 0;

    [loop]
    for (int j = 0; j < MULTI_SCATTERING_STEPS; ++j)
    {
        float d_j = (j + 0.5) * dx1;
        float3 pos_j = pos + d_j * ray1;

        float r_j_sq = dot(pos_j, pos_j);
        float inv_r_j = rsqrt(r_j_sq);
        float r_j = r_j_sq * inv_r_j;
        float h_j = max(0.0, r_j - bottomR);
        float sun_mu_j = dot(sunRay, pos_j) * inv_r_j;

        float rayleighDensity = exp2(-h_j * scaleR * 1.442695);
        float mieDensity = exp2(-h_j * scaleM * 1.442695);
        float ozoneDensity = max(0.0, 1.0 - abs(h_j - ozoneCenter) * invOzoneHalfWidth);

        float3 rayleighScat = rayleighDensity * rayleighExtCoeff;
        float3 mieScat = mieDensity * mieScatCoeff;
        float3 scattering = rayleighScat + mieScat;
        float3 extinction = rayleighScat + mieDensity * mieExtCoeff
                          + ozoneDensity * ozoneAbsCoeff;

        opticalDepth1 += extinction * dx1;
        float3 transmittance = exp2(-opticalDepth1 * 1.442695);
        finalTrans1 = transmittance;

        float3 sunTrans = GetTransmittanceToTopBoundaryFast(
            params, r_j, sun_mu_j, transmittanceW, transmittanceH);

        float sinThetaH = saturate(bottomR * inv_r_j);
        float cosThetaH = -sqrt(max(0.0, 1.0 - sinThetaH * sinThetaH));
        float edge0 = cosThetaH - sinThetaH * sunAngularRadius;
        float edge1 = cosThetaH + sinThetaH * sunAngularRadius;
        float visibility = smoothstep(edge0, edge1, sun_mu_j);

        float3 stepScatter = transmittance * scattering * dx1;
        rayL2_1 += stepScatter * sunTrans * visibility * phaseL2;
        rayMS_1 += stepScatter;
    }

    if (intersects1)
    {
        float3 hitPos = pos + ray1 * dist1;
        float nDl = saturate(dot(sunRay, hitPos) / bottomR);
        float3 groundSunTrans = GetTransmittanceToTopBoundaryFast(
            params, bottomR, nDl, transmittanceW, transmittanceH);
        float vis_g = smoothstep(-sunAngularRadius, sunAngularRadius, nDl);
        rayL2_1 += groundAlbedo * groundSunTrans * vis_g * nDl * finalTrans1 / PI_;
    }

    float3 combinedL2 = rayL2_0 + rayL2_1;
    float3 combinedMS = rayMS_0 + rayMS_1;

    float3 totalL2 = WaveActiveSum(combinedL2);
    float3 totalMS = WaveActiveSum(combinedMS);

    if (WaveGetLaneIndex() == 0)
    {
        float factor = phaseL2 * 4.0 * PI_ / MULTI_SCATTERING_RAYS;
        totalL2 *= factor;
        totalMS *= factor;
        float3 result = totalL2 / max(1.0 - totalMS, 0.00001);
        _MultiScatteringLutUAV[pixelId] = float4(result, 1.0);
    }
}
[numthreads(8, 8, 1)]
void kComputeSkyViewLut(uint3 id : SV_DispatchThreadID)
{
    uint2 size;
    _SkyViewLutUAV.GetDimensions(size.x, size.y);
    if (id.x >= size.x || id.y >= size.y)
    {
        return;
    }
    SkyAtmosphereParameters skyAtmosphereParameters = GetWorkingSkyAtmosphereParameters(_SkyAtmosphereParametersBuffer[0]);
    float2 uv = (id.xy + 0.5f) / size.xy;
    float bottom = GetAtmosphereBottom(skyAtmosphereParameters);
    float top = GetAtmosphereTop(skyAtmosphereParameters);
    float height = GetCameraY(skyAtmosphereParameters);
    float azimuth = (uv.x - 0.5f) * 2.0f * PI_;
    float latitude = GetSkyViewTextureLFromV(uv.y);
    float mu = sin(latitude);
    float sinTheta = cos(latitude);

    float3 ray = float3(sinTheta * cos(azimuth), mu, sinTheta * sin(azimuth));
    float3 pos = float3(0, height + bottom, 0);
    float3 sunRay = skyAtmosphereParameters.sunParameterPacked.xyz;

    float3 finalColor = float3(0, 0, 0);

    bool intersects = RayIntersectsGround(skyAtmosphereParameters, pos.y, mu);
    float distance = intersects
                         ? DistanceToBottomAtmosphereBoundary(bottom, pos.y, mu)
                         : DistanceToTopAtmosphereBoundary(top, pos.y, mu);
    float dx = distance / SKY_VIEW_STEPS;

    float cosTheta = dot(ray, sunRay);
    float phaseRayleigh = RayleighPhase(cosTheta);
    float phaseMie = MiePhase(cosTheta, skyAtmosphereParameters.mieScatteringPacked.w);

    float3 opticalDepth = float3(0, 0, 0);
    float3 prevExtinction = float3(0, 0, 0);

    uint transmittanceW, transmittanceH;
    _TransmittanceLut.GetDimensions(transmittanceW, transmittanceH);

    for (int i = 0; i <= SKY_VIEW_STEPS; ++i)
    {
        float3 pos_i = pos + ray * dx * i;
        float r_i = length(pos_i);
        float h_i = r_i - bottom;
        float sun_mu_i = dot(sunRay, pos_i) / r_i;

        float3 rayleighScattering = GetRayleighIntensity(skyAtmosphereParameters, h_i) * skyAtmosphereParameters.rayleighScattering.xyz;
        float3 mieScattering = GetMieIntensity(skyAtmosphereParameters, h_i) * skyAtmosphereParameters.mieScatteringPacked.xyz;
        float3 mieAbsorption = GetMieIntensity(skyAtmosphereParameters, h_i) * skyAtmosphereParameters.mieAbsorption.xyz;
        float3 ozoneAbsorption = GetOzoneIntensity(skyAtmosphereParameters, h_i) * skyAtmosphereParameters.ozoneAbsorption.xyz;

        float3 currentExtinction = rayleighScattering + mieScattering + mieAbsorption + ozoneAbsorption;

        if (i > 0)
        {
            opticalDepth += (prevExtinction + currentExtinction) * 0.5f * dx;
        }
        prevExtinction = currentExtinction;

        float3 transmittance_i = exp(-opticalDepth);

        float3 transmittanceToSun_i = GetTransmittanceToTopBoundaryFast(
    skyAtmosphereParameters, r_i, sun_mu_i, transmittanceW, transmittanceH);
        float visibility = GetSunVisibility(skyAtmosphereParameters, r_i, sun_mu_i);

        float3 singleScattering_i = (rayleighScattering * phaseRayleigh + mieScattering * phaseMie) * transmittanceToSun_i;
        float3 multiScattering_i = GetMultiScattering(skyAtmosphereParameters, r_i, sun_mu_i) * (rayleighScattering + mieScattering);

        float weight = (i == 0 || i == SKY_VIEW_STEPS) ? 0.5f : 1.0f;
        finalColor += transmittance_i * (singleScattering_i * visibility + multiScattering_i )  * dx * weight;
    }

    _SkyViewLutUAV[id.xy] = float4(finalColor * GetSunPower(skyAtmosphereParameters), 1.0f);
}


float4x4 _InverseViewProjMatrix;
float4 _CameraPosition;

[numthreads(8, 8, 4)]
void kComputeAerialPerspectiveLut(uint3 id : SV_DispatchThreadID)
{
    uint3 size;
    _AerialPerspectiveLutUAV.GetDimensions(size.x, size.y, size.z);
    if (id.x >= size.x || id.y >= size.y || id.z >= size.z)
    {
        return;
    }
    SkyAtmosphereParameters skyAtmosphereParameters = GetWorkingSkyAtmosphereParameters(_SkyAtmosphereParametersBuffer[0]);
    float2 uv = (id.xy + 0.5f) / size.xy;
    float2 ndc = uv * 2.0f - 1.0f;

    float4 target = mul(_InverseViewProjMatrix, float4(ndc, 0.5f, 1.0f));
    float3 ray = normalize(target.xyz - _CameraPosition.xyz);
    float slice = (id.z + 0.5f) / size.z;
    float distance = GetFogDistanceFromSlice(slice);
    float bottom = GetAtmosphereBottom(skyAtmosphereParameters);

    float3 sunRay = skyAtmosphereParameters.sunParameterPacked.xyz;
    float3 pos = float3(0, GetCameraY(skyAtmosphereParameters) + bottom, 0);

    float cosTheta = dot(ray, sunRay);
    float phaseRayleigh = RayleighPhase(cosTheta);
    float phaseMie = MiePhase(cosTheta, skyAtmosphereParameters.mieScatteringPacked.w);
    float dx = distance / AERIAL_PERSPECTIVE_STEPS;

    float3 finalColor = float3(0.0f, 0.0f, 0.0f);
    float3 opticalDepth = float3(0, 0, 0);
    float3 prevExtinction = float3(0, 0, 0);

    uint transmittanceW, transmittanceH;
    _TransmittanceLut.GetDimensions(transmittanceW, transmittanceH);

    for (int i = 0; i <= AERIAL_PERSPECTIVE_STEPS; ++i)
    {
        float3 pos_i = pos + ray * dx * i;
        float r_i = length(pos_i);
        float h_i = max(r_i - bottom, 0.001f);
        float sun_mu_i = dot(sunRay, pos_i) / r_i;

        float3 rayleighScattering = GetRayleighIntensity(skyAtmosphereParameters, h_i) * skyAtmosphereParameters.rayleighScattering.xyz;
        float3 mieScattering = GetMieIntensity(skyAtmosphereParameters, h_i) * skyAtmosphereParameters.mieScatteringPacked.xyz;
        float3 mieAbsorption = GetMieIntensity(skyAtmosphereParameters, h_i) * skyAtmosphereParameters.mieAbsorption.xyz;
        float3 ozoneAbsorption = GetOzoneIntensity(skyAtmosphereParameters, h_i) * skyAtmosphereParameters.ozoneAbsorption.xyz;

        float3 currentExtinction = rayleighScattering + mieScattering + mieAbsorption + ozoneAbsorption;

        if (i > 0)
        {
            opticalDepth += (prevExtinction + currentExtinction) * 0.5f * dx;
        }
        prevExtinction = currentExtinction;

        float3 transmittance_i = exp(-opticalDepth);

        float3 transmittanceToSun_i = GetTransmittanceToTopBoundaryFast(
   skyAtmosphereParameters, r_i, sun_mu_i, transmittanceW, transmittanceH);
        float visibility = GetSunVisibility(skyAtmosphereParameters, r_i, sun_mu_i);

        float3 singleScattering_i = (rayleighScattering * phaseRayleigh + mieScattering * phaseMie) * transmittanceToSun_i;
        float3 multiScattering_i = GetMultiScattering(skyAtmosphereParameters, max(r_i, bottom + 0.001f), sun_mu_i) * (rayleighScattering + mieScattering);

        float weight = (i == 0 || i == AERIAL_PERSPECTIVE_STEPS) ? 0.5f : 1.0f;
        finalColor += transmittance_i * (singleScattering_i * visibility + multiScattering_i)  * dx * weight;
    }
    float alpha = dot(exp(-opticalDepth), float3(0.333333f, 0.333333f, 0.333333f));
    _AerialPerspectiveLutUAV[id] = float4(finalColor * GetSunPower(skyAtmosphereParameters), alpha);
}